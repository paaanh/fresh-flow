# Development defaults only. Replace these values before deployment.
ENVIRONMENT=development
MYSQL_PASSWORD=replace-with-a-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-mysql-root-password
JWT_SECRET=replace-with-generated-random-secret-at-least-32-characters

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
